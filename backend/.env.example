STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
CONTRACT_ID=<your deployed contract id here>

# SDF reference anchor (testnet)
ANCHOR_HOME_DOMAIN=testanchor.stellar.org
ANCHOR_SIGNING_KEY=<your backend signing key — G...>
ANCHOR_SECRET_KEY=<your backend secret key — S...>

# SEP-10 token JWT secret (generate a random 32-byte hex)
JWT_SECRET=<random 32-byte hex>

# SQLite database path
DATABASE_PATH=./data/stellarpe.sqlite

# Backend server settings
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Optional: Sentry DSN for error tracking
SENTRY_DSN=
